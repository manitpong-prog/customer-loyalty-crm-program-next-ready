# Neon pooled connection string. Recommended for Vercel / serverless runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional unpooled connection string. Keep for scripts / migrations if Neon-Vercel integration provides it.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Public URL of the deployed app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default production shop shown by /customer and /merchant.
NEXT_PUBLIC_DEFAULT_SHOP_ID="im_sticker"

# Auto-seed behavior when Neon is empty: pilot | demo | none
# pilot = create iM Sticker baseline, demo = create original mock data, none = keep database empty.
CRM_AUTO_SEED="pilot"

# Safety switch for POST /api/db/reset. Keep false unless you intentionally want to reset test data.
ALLOW_DB_RESET="false"
