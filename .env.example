# App runtime mode
# development = mock/demo fallback allowed when NEXT_PUBLIC_ENABLE_DEMO_DATA=true
# production = Supabase-only; mock/demo fallback is disabled
NEXT_PUBLIC_APP_MODE="development"
NEXT_PUBLIC_ENABLE_DEMO_DATA="true"

# Supabase SSR Configuration (Vercel-ready SaaS)
# Public keys are safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only key. Never expose this value in client components.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# LINE LIFF SDK Integration
NEXT_PUBLIC_LINE_LIFF_ID="2010316209-crUhQOFJ"
# Unified LINE entry flow
# Use this LIFF URL when users open customer pages from the regular website.
NEXT_PUBLIC_LINE_LIFF_URL="https://liff.line.me/2010316209-crUhQOFJ"
NEXT_PUBLIC_LIFF_BASE_URL="https://liff.line.me/2010316209-crUhQOFJ"

# Set to "true" in production if customer pages must always be opened through LINE/LIFF.
NEXT_PUBLIC_REQUIRE_LINE_FOR_CUSTOMER="false"

# Optional production debug flags.
NEXT_PUBLIC_SHOW_LIFF_DEBUG="false"
NEXT_PUBLIC_SHOW_DEMO_STORE_ENTRY="false"
NEXT_PUBLIC_SHOW_DEV_TOOLS="false"

# Server-side LINE Login verification
# Use the numeric Channel ID, not the full LIFF ID. Example: LIFF 2010316209-crUhQOFJ => Channel ID 2010316209
LINE_LOGIN_CHANNEL_ID="2010316209"
LINE_CHANNEL_ID="2010316209"
LINE_CHANNEL_SECRET=""

# strict = require a verified LINE ID token for customer/member/claim/redeem flows.
# optional = allow legacy lineUserId fallback while debugging only.
LINE_ID_TOKEN_VERIFICATION_MODE="strict"

# Development fallback for testing outside LINE In-App Browser.
# Set to "false" in production. Server routes reject source="dev" when this is false.
NEXT_PUBLIC_ENABLE_DEV_LINE_FALLBACK="true"
NEXT_PUBLIC_LINE_DEV_USER_ID="U91a2bc83d47f0923d881e"
NEXT_PUBLIC_LINE_DEV_DISPLAY_NAME="Kavin Woradech"
NEXT_PUBLIC_LINE_DEV_PICTURE_URL=""

# Default merchant shortcut
# Leave empty for multi-merchant SaaS. /merchant redirects to /merchant/portal when empty.
NEXT_PUBLIC_DEFAULT_MERCHANT_SLUG=""

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional / legacy AI Studio value. Not required for Loyalty MVP.
GEMINI_API_KEY=""

# Supabase Storage
# Image uploads use the server-side merchant-assets bucket created by supabase/storage-images-v1.sql.
# No NEXT_PUBLIC storage bucket env is required.

# Optional but recommended. Used to sign short-lived merchant dashboard access after PIN unlock.
# If omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY for signing.
MERCHANT_ACCESS_TOKEN_SECRET="change-me-to-a-long-random-secret"
